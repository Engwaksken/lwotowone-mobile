diff --git a/scripts/build-apk.ps1 b/scripts/build-apk.ps1
new file mode 100644
index 0000000..44e1a5e
--- /dev/null
+++ b/scripts/build-apk.ps1
@@ -0,0 +1,23 @@
+param(
+  [Parameter(Mandatory=$true)][string]$ApiBaseUrl,
+  [switch]$RequireReleaseKey
+)
+$ErrorActionPreference = 'Stop'
+$projectPath = Split-Path -Parent $PSScriptRoot
+Set-Location $projectPath
+$uri = $null
+if (-not [Uri]::TryCreate($ApiBaseUrl, [UriKind]::Absolute, [ref]$uri) -or $uri.Scheme -ne 'https' -or -not $uri.AbsolutePath.EndsWith('/api') -or $uri.Query -or $uri.Fragment -or $uri.UserInfo) { throw 'Use an HTTPS API address ending in /api.' }
+if ($uri.Host -match '(^|\.)example\.com$|your-domain') { throw 'Replace the placeholder with your actual Laravel API address.' }
+if (-not (Test-Path 'android/key.properties')) {
+  if ($RequireReleaseKey) { throw 'Add android/key.properties and your upload keystore before building for distribution.' }
+  Write-Warning 'No release key configured. This APK will use debug signing for testing.'
+}
+flutter pub get
+if ($LASTEXITCODE -ne 0) { throw 'Flutter dependencies failed.' }
+flutter analyze
+if ($LASTEXITCODE -ne 0) { throw 'Flutter analysis failed.' }
+flutter test
+if ($LASTEXITCODE -ne 0) { throw 'Flutter tests failed.' }
+flutter build apk --release "--dart-define=API_BASE_URL=$ApiBaseUrl"
+if ($LASTEXITCODE -ne 0) { throw 'APK build failed.' }
+Write-Output (Join-Path $projectPath 'build/app/outputs/flutter-apk/app-release.apk')
diff --git a/scripts/check_api_url.py b/scripts/check_api_url.py
new file mode 100644
index 0000000..bc46935
--- /dev/null
+++ b/scripts/check_api_url.py
@@ -0,0 +1,15 @@
+import os
+from urllib.parse import urlparse
+address = os.environ.get("API_BASE_URL", "")
+uri = urlparse(address)
+host = (uri.hostname or "").lower()
+if (uri.scheme != "https" or not host or not uri.path.endswith("/api")
+    or uri.query or uri.fragment or uri.username or uri.password
+    or host == "example.com" or host.endswith(".example.com") or "your-domain" in host):
+    raise SystemExit("Use your actual HTTPS API address ending in /api.")
+try:
+    if uri.port is not None and not 1 <= uri.port <= 65535:
+        raise ValueError("Port out of range")
+except ValueError:
+    raise SystemExit("Use a valid API port.")
+print("API build configuration validated.")
diff --git a/test/api_config_test.dart b/test/api_config_test.dart
new file mode 100644
index 0000000..329d004
--- /dev/null
+++ b/test/api_config_test.dart
@@ -0,0 +1,44 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:lwotowone_mobile/services/api_config.dart';
+import 'package:lwotowone_mobile/services/repository.dart';
+import 'package:http/testing.dart';
+import 'package:http/http.dart' as http;
+
+void main() {
+  test(
+    'API build configuration rejects placeholders and credential-bearing addresses',
+    () {
+      for (final url in [
+        'https://example.com/api',
+        'https://YOUR-DOMAIN/api',
+        'http://learning.test/api',
+        'https://learning.test',
+        'https://user:password@learning.test/api',
+        'https://learning.test/api?token=x',
+        'https://learning.test/api#x',
+      ]) {
+        expect(ApiConfig.validate(url), isNotNull, reason: url);
+      }
+      expect(ApiConfig.validate('https://learning.test/api'), isNull);
+    },
+  );
+  test('Unconfigured app never sends a network request', () async {
+    var calls = 0;
+    final repo = Repository(
+      baseUrl: 'https://example.com/api',
+      client: MockClient((r) async {
+        calls++;
+        return http.Response('{}', 200);
+      }),
+    );
+    await expectLater(
+      repo.request('POST', '/login', {
+        'email': 'test@example.test',
+        'password': 'test',
+      }),
+      throwsA(isA<ApiFailure>()),
+    );
+    expect(calls, 0);
+    repo.dispose();
+  });
+}
